# 边界殖民地 v6.4 · 环境变量
#
# 一般不用手改这个文件：打开网页，在左栏「接入大模型」选服务商、粘贴 API Key、
# 点「保存为模型」即可。可以保存多份（不同服务商 / 不同 Key），保存在
# data/llm-profiles.json（已被 .gitignore 忽略），势力操控下拉里可逐个选给 A/B/C/D。
# 勾选「同时写入本机 .env」时，当前默认模型的配置也会写回下面几行，作为启动兜底。
# 只填一个 API Key 就能跑；端点、模型、温度、超时都有预设。

# OpenAI 兼容端点（OpenAI / DeepSeek / 通义千问 / 智谱 / Moonshot / Ollama / vLLM 等）
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# 可选：Anthropic 原生端点（在左栏服务商里选 Anthropic 时生效）
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929

# 游戏参数
PORT=3000
TURN_DELAY_MS=1200
DEFAULT_TURNS=120

# 启动行为：默认每次启动自动开一局 T0 初始棋盘（固定布局，回合数归零）。
# 想让服务启动后保持空棋盘、由自己点「新开一局」，就设成 0。
# AUTO_START=0
# AUTO_START_SEED=20261106

# 安全：默认只监听本机（127.0.0.1），服务没有鉴权。需要局域网访问才设 HOST=0.0.0.0。
# 自定义端点默认只允许 https 公网 / http 本机；局域网自建模型服务需放行时设为 1。
# HOST=127.0.0.1
# LLM_ALLOW_PRIVATE_ENDPOINTS=0

# 可选：改对局记忆 / 多模型配置的落盘位置（默认都在 data/ 下，已被 .gitignore 忽略）
# 记忆文件保存跨局战绩、败因与复盘经验；删掉它等于清空学习记录。
# LLM_MEMORY_FILE=data/llm-memory.json
# LLM_PROFILES_FILE=data/llm-profiles.json
